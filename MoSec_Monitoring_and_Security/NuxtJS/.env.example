# ─────────────────────────────────────────────────────────────────────
# Dummy IoT sender toggle (for `docker compose up`)
# ─────────────────────────────────────────────────────────────────────
# The fake IoT sender runs as the `dummy-iot` service, gated by a Compose
# profile. Docker Compose reads COMPOSE_PROFILES from this .env file:
#   COMPOSE_PROFILES=dummy   -> sender runs on `docker compose up`
#   COMPOSE_PROFILES=        -> sender OFF (default)
COMPOSE_PROFILES=dummy

# How often (ms) the sender pushes a reading per room. Default 5000.
DUMMY_INTERVAL_MS=5000

# ─── Incident rate (incidents per DAY, whole building) ───────────────
# Intuitive knob: how many incidents to generate per day across ALL rooms.
# The sender converts this to a tiny per-tick chance automatically, so it
# stays correct regardless of DUMMY_INTERVAL_MS or room count.
DOOR_INCIDENTS_PER_DAY=1.5   # "room left unlocked" events per day
PROJ_INCIDENTS_PER_DAY=2     # "projector left on" events per day
# How fast an open door / on projector returns to normal (session length).
DOOR_CLOSE_CHANCE=0.5
PROJ_OFF_CHANCE=0.3

# ─────────────────────────────────────────────────────────────────────
# Local (non-docker) dev only
# ─────────────────────────────────────────────────────────────────────
# Needed when running `npm run dev` outside docker. Inside docker this is
# provided by docker-compose. Host-mapped DB port is 5433.
# DATABASE_URL=postgresql://postgres:root@localhost:5433/mosec
