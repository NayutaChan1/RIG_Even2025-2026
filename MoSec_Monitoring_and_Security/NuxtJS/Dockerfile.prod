# ==========================================
# STAGE 1: PABRIK (BUILDER)
# ==========================================
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm install

COPY . ./
RUN npm run build

# ==========================================
# STAGE 2: ETALASE (PRODUCTION RUNNER)
# ==========================================
FROM node:22-alpine
WORKDIR /app

COPY --from=build /app/.output/ ./

# Auto-migrate: copy drizzle config + migrations, install drizzle-kit
COPY drizzle.config.ts drizzle/ ./
COPY server/utils/ ./server/utils/
COPY docker-entrypoint.sh ./
RUN chmod +x docker-entrypoint.sh && npm init -y && npm install drizzle-kit postgres tsx

ENV PORT=3000
ENV HOST=0.0.0.0

EXPOSE 3000

CMD ["./docker-entrypoint.sh", "prod"]