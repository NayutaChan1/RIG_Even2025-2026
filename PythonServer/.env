# ── Briefing PPTX server configuration ──────────────────────────────
# All settings live here; loaded automatically at startup by python-dotenv.

# ── Schedule source ────────────────────────────────────────────────
# "classtransaction" = live ClassTransaction API, matched by assistant + day + shift
# "api"              = live Schedule/GetJobsAssistant (dated assistant duties)
# "file"             = TransactionSchedule.json offline snapshot
BRIEFING_SCHEDULE_SOURCE=classtransaction

# ── Day + shift to match ───────────────────────────────────────────
# DEVELOPMENT: hardcode the day-of-week (Mon=1 .. Sun=7) and shift window.
# REALTIME: leave BOTH empty -> uses the current weekday + current time slot.
BRIEFING_DAY=6
BRIEFING_SHIFT=11:20-13:00

# ── Assistant (fallback only) ──────────────────────────────────────
# The real assistant initial comes from the card tap (Flazz_Id -> NuxtJS ->
# initial) and is sent in the request, which takes priority. This is only used
# for curl/manual tests without the desktop.
BRIEFING_ASSISTANT_CODE=FB25-1

# Optional extra class filter. Normally day+shift+assistant is unique, so leave
# empty. The request's class_code (future: from tapped room) takes priority.
BRIEFING_CLASS_CODE=

# ── Assessment table defaults (used when the course feed omits a field) ──
BRIEFING_DEFAULT_DURATION=100 menit di awal
BRIEFING_DEFAULT_PARTICIPANTS=1 orang

# ── Optional overrides (sensible defaults already in code) ──────────
# BLUEJACK_API_BASE=https://bluejack.binus.ac.id/lapi/api
# SEMESTER_ID=c93afa56-601f-46a6-ab51-671ba9a96328
# CLASS_TRANSACTION_URL=https://bluejack.binus.ac.id/lapi/API/ClassTransaction/GetClassTransactionInSemester
# BRIEFING_NOW_OVERRIDE=        # for "file"/"api" sources only
# HOST=0.0.0.0
# PORT=8000
